APP_NAME="GPM Conecta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gpm-conecta.local"
MAIL_FROM_NAME="${APP_NAME}"
GPM_ADMIN_NAME="Administrador GPM"
GPM_ADMIN_EMAIL=admin@gpm.local
GPM_ADMIN_PASSWORD=ChangeMe123!
